module answers

# Exercise 13-1: add "the shortest word" to Stats. The empty string cannot
# serve as the initial value, so "not yet any" is null (chapter 7).
record Stats:
    count: Int
    totalChars: Int
    longest: String
    shortest: String?

let empty = Stats(count = 0, totalChars = 0, longest = "", shortest = null)

def pickShortest(current: String?, w: String): String =
    if current == null:
        w
    elif length(w) < length(current):
        w
    else:
        current

def step(s: Stats, w: String): Stats =
    let n = length(w)
    let longer = if n > length(s.longest) then w else s.longest
    let shorter = pickShortest(s.shortest, w)
    Stats(count = s.count + 1, totalChars = s.totalChars + n, longest = longer, shortest = shorter)

let words = ["the", "quick", "brown", "fox", "jumps"]

let summary = fold(words, empty, step)

let emptySummary = fold([], empty, step)
