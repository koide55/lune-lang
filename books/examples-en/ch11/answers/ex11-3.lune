module answers

# Exercise 11-3: judging a round. beats is the building block; the three
# outcomes are sorted out with if/elif.
type Hand =
    | Rock
    | Paper
    | Scissors

def beats(a: Hand, b: Hand): Bool =
    match (a, b):
        | (Rock, Scissors) -> true
        | (Paper, Rock) -> true
        | (Scissors, Paper) -> true
        | _ -> false

def judge(a: Hand, b: Hand): String =
    if beats(a, b):
        "win"
    elif beats(b, a):
        "lose"
    else:
        "draw"

let won = judge(Rock(), Scissors())

let lost = judge(Rock(), Paper())

let tied = judge(Rock(), Rock())
